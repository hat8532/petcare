<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.petcare.backend.domain.auth.RefreshTokenMapper">

    <insert id="insert">
        INSERT INTO refresh_tokens (user_id, token, expiry_date)
        VALUES (#{userId}, #{tokenHash}, #{expiryDate})
    </insert>

    <delete id="deleteValid">
        DELETE FROM refresh_tokens
        WHERE user_id = #{userId}
          AND token = #{tokenHash}
          AND expiry_date &gt; #{now}
    </delete>

    <delete id="deleteByTokenHash">
        DELETE FROM refresh_tokens WHERE token = #{tokenHash}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM refresh_tokens WHERE user_id = #{userId}
    </delete>

    <delete id="deleteExpired">
        DELETE FROM refresh_tokens WHERE expiry_date &lt;= #{now}
    </delete>

</mapper>
