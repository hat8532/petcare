<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.petcare.backend.domain.community.CommentMapper">

    <!--
      comments 테이블 기준으로 조회한다.
      화면이 쓰는 authorName은 comments에 컬럼이 없으므로 users에서 가져와 붙인다.
      timeAgo는 저장하지 않고 createdAt으로 Controller에서 계산한다.
    -->
    <sql id="commentColumns">
        c.id            AS id,
        c.post_id       AS postId,
        c.user_id       AS userId,
        u.nickname      AS authorName,
        c.parent_id     AS parentId,
        c.content       AS content,
        c.created_at    AS createdAt
    </sql>

    <sql id="commentJoins">
        FROM comments c
        LEFT JOIN users u ON u.id = c.user_id
    </sql>

    <!-- 대화 순서대로 보여야 하므로 게시글 목록과 달리 오래된 순(ASC)이다. -->
    <select id="findByPostId" resultType="com.petcare.backend.domain.community.CommentDTO">
        SELECT <include refid="commentColumns"/>
        <include refid="commentJoins"/>
        WHERE c.post_id = #{postId}
        ORDER BY c.id ASC
    </select>

    <select id="findById" resultType="com.petcare.backend.domain.community.CommentDTO">
        SELECT <include refid="commentColumns"/>
        <include refid="commentJoins"/>
        WHERE c.id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comments (post_id, user_id, parent_id, content)
        VALUES (#{postId}, #{userId}, #{parentId}, #{content})
    </insert>

    <!-- user_id 조건이 없으면 남의 댓글도 지워진다. 반드시 함께 건다. -->
    <delete id="deleteByIdAndUserId">
        DELETE FROM comments
        WHERE id = #{id} AND user_id = #{userId}
    </delete>

</mapper>
