# Frontend Environment Variables Template (.env)

# 🤖 Google Gemini API Key (Direct Frontend Testing Optional)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 🗺️ Kakao Map API JavaScript Key (100% Free)
VITE_KAKAO_MAP_API_KEY=YOUR_KAKAO_JAVASCRIPT_KEY_HERE

# 🗺️ Naver Maps Client ID (Alternative)
VITE_NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID_HERE
